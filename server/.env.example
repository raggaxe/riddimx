# Filled in by install.sh. DOMAIN can be your own (live.example.com) or, with no domain at all,
# the server's IP through sslip.io: 203-0-113-7.sslip.io (free, no account).
DOMAIN=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# The app sends this to open a set. Put the same value in the app's build (VITE_RELAY_KEY).
RELAY_KEY=
